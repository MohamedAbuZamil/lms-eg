generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  mobile       String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  name         String?
  createdAt    DateTime @default(now())
}